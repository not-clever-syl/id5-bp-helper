# 本地归档：被清理的非运行时文件（原始数据、构建管线、死脚本）。
# 上传 GitHub 时不包含；需要重建数据时从这里取回。
tmp/

# 本机的功能测试脚本（只在本地跑，不入库）
test/

# 本地 AI 助手约定（个人调试用，不入库）
AGENTS.md

static_web_ver/

# 本地生成的测试报告（含预制报告，都是本机测试产物）
data/reports/

# 监管选手配置 / 求生角色池：只有随项目带来的版本 1 入库。
# 页面上导出的 _2、_3… 是本机产物，不提交。
data/hunter/*.json
!data/hunter/*_1.json
data/survivor/*.json
!data/survivor/*_1.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# macOS 在非 HFS 卷上会生成 AppleDouble 元数据文件（形如 ._foo）
._*

# 日志与临时文件
*.log
*.out

# 编辑器备份与临时文件
*.tmp
*.bak
*.swp
*~
